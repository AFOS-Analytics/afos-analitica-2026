{
  "name": "afos-analitica-2026",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source civic intelligence platform cross-referencing prediction markets, polling data and verified news for Brazil 2026 elections — global by design.",
  "homepage": "https://www.afos-analytics.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/AFOS-Analytics/afos-analitica-2026.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "elections",
    "prediction-markets",
    "polling",
    "political-intelligence",
    "open-source",
    "polymarket",
    "tse",
    "brazil-2026",
    "civic-tech"
  ],
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "check:locale": "tsx scripts/check-locale-json.ts",
    "check:content": "tsx scripts/validate-polls-data.ts && tsx scripts/check-json-structure.ts && tsx scripts/check-hardcoded-ptbr.ts && tsx scripts/test-json-number-gate.ts && tsx scripts/check-locale-json.ts",
    "check:frescor": "tsx scripts/check-frescor-editorial.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/d3": "^7.4.3",
    "@types/topojson-client": "^3.1.5",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "d3": "^7.9.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "next": "^15.5.23",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "topojson-client": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.19.37",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.20",
    "postcss": "^8.5.15",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.19",
    "tsx": "4.23.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fast-uri": ">=4.1.3",
    "postcss": "$postcss",
    "deepmerge-ts": ">=8.0.0"
  }
}
