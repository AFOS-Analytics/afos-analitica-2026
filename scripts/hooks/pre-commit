#!/bin/sh
# AFOS Analytics — pre-commit hook
# Camada 2.5 (fechamento do gap C2 → automação): valida schema de polls-data.json
# antes de qualquer commit que toque o arquivo. Documentado em
# memory/project_dashboard_4layer_defense.md.
#
# Para reinstalar em uma nova clone:
#   bash scripts/hooks/install.sh

set -e

# Lista arquivos staged. Se polls-data.json não está no commit, sai 0 (passa).
STAGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || echo "")

# Os 4 arquivos carregam os MESMOS números. Antes o hook só disparava em 2
# deles, então um commit que mexesse apenas em analysis-data.json ou no
# CandidatesSection.tsx passava sem validação nenhuma. Só não apareceu porque
# o /atualizar commita os quatro juntos; qualquer correção pontual escapava.
if echo "$STAGED" | grep -qE '(^|/)(public/(polls-data|analysis-criteriosa|analysis-data)\.json|app/components/CandidatesSection\.tsx)$'; then
  echo "🔍 pre-commit: polls-data/analysis-criteriosa staged — validando schema canônico..."
  if ! npx tsx scripts/validate-polls-data.ts; then
    echo ""
    echo "❌ pre-commit BLOQUEADO: polls-data.json não passou no validator."
    echo "   Schema canônico em memory/feedback_polls_data_canonical_schema.md"
    echo "   Para inspecionar erros: npx tsx scripts/validate-polls-data.ts"
    echo "   Para bypass de emergência (NÃO recomendado): git commit --no-verify"
    exit 1
  fi
  echo "✅ pre-commit: polls-data.json OK"
fi

# Prosa em português embutida em componente NOVO.
#
# Em 25/Jul/2026 o dashboard ganhou versão EN e ES, mas o CandidatesSection
# tem a prosa escrita DENTRO do componente e por isso ficou de fora: a seção
# de perfis aparece em português para quem lê em inglês. O André decidiu
# preservar o legado e travar o crescimento. Conteúdo editorial novo vai para
# JSON em public/, que tem pipeline de tradução na ETAPA 3.5 do /atualizar.
# O gatilho cobre app/ INTEIRO, não só app/components/. O guard varre as 102
# .tsx recursivamente, incluindo as páginas de app/[locale]/, que é onde uma
# seção nova nasceria; disparar só em components/ deixaria justamente esse caso
# passar sem checagem.
if echo "$STAGED" | grep -qE '^app/.*\.tsx$'; then
  echo "🔍 pre-commit: .tsx staged — checando prosa pt-BR embutida..."
  if ! npx tsx scripts/check-hardcoded-ptbr.ts; then
    echo ""
    echo "❌ pre-commit BLOQUEADO: componente novo com prosa em português."
    echo "   Conteúdo editorial vai para JSON em public/ (tem tradução EN/ES)."
    echo "   Se for legado que precisa ficar, adicione o arquivo em LEGADO"
    echo "   dentro de scripts/check-hardcoded-ptbr.ts, com justificativa."
    exit 1
  fi
fi

# Gate numerico: e a unica coisa entre uma traducao errada e o leitor. Se o
# arquivo dele for tocado, a bateria roda. Cada caso da bateria corresponde a
# um defeito real de 24 e 25/Jul, entao regressao ali sai caro.
if echo "$STAGED" | grep -qE '^scripts/lib/json-number-gate\.ts$'; then
  echo "🔍 pre-commit: gate numérico staged — rodando bateria..."
  if ! npx tsx scripts/test-json-number-gate.ts; then
    echo ""
    echo "❌ pre-commit BLOQUEADO: o gate numérico regrediu."
    echo "   NÃO relaxe o caso de teste: ele existe porque o defeito aconteceu."
    exit 1
  fi
fi

# Backup do Neon indo para um repositorio PUBLICO. A classificacao por tabela
# dentro do backup-neon.ts e a primeira barreira, mas ela confia em quem
# classificou. Esta e a segunda: olha o CONTEUDO. Um e-mail pode aparecer dentro
# de um JSON de research sem ninguem prever, e uma vez empurrado para um repo
# publico nao ha como despublicar.
if echo "$STAGED" | grep -qE '^backup/neon/'; then
  echo "🔍 pre-commit: backup do Neon staged — varrendo atrás de dado pessoal..."
  if ! npx tsx scripts/check-backup-sem-pii.ts; then
    echo ""
    echo "❌ pre-commit BLOQUEADO: possível dado pessoal no backup."
    echo "   O repositório é PÚBLICO. Reclassifique a tabela em scripts/backup-neon.ts"
    echo "   e gere o backup de novo. NÃO use --no-verify aqui."
    exit 1
  fi
fi

exit 0
