{
  "ignoreCommand": "git diff --name-only HEAD^ HEAD|grep -qvE '^(docs|tests|scripts)/|^(README|CONTRIBUTING|SECURITY|TRADEMARK|CODE_OF_CONDUCT)\\.md$|^(LICENSE|NOTICE)$'&&exit 1||exit 0",
  "crons": [
    {
      "path": "/api/cron/refresh-elections",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/purge-visitor-state",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/purge-chat-logs",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/refresh-kalshi",
      "schedule": "15,45 * * * *"
    },
    {
      "path": "/api/cron/refresh-us-polls",
      "schedule": "10 7 * * *"
    },
    {
      "path": "/api/cron/refresh-fr-polls",
      "schedule": "40 7,19 * * *"
    },
    {
      "path": "/api/cron/refresh-fr-press",
      "schedule": "25 6,12,18 * * *"
    },
    {
      "path": "/api/cron/refresh-us-press",
      "schedule": "20 7,13,19 * * *"
    }
  ]
}
